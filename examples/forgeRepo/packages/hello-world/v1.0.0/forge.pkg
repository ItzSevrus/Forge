[package]
name = "hello-world"
version = "1.0.0"
description = "A minimal example package"
license = "MIT"

[source]
url = "https://example.org/hello-world-1.0.0.tar.gz"
checksum = "sha256:PUT_THE_64_HEX_DIGIT_SHA256_HERE"

[build]
script = "build.sh"
command = "./build.sh"
compilers = ["cc"]

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["build-essential"]
pacman = ["base-devel"]
dnf = ["gcc", "make"]
zypper = ["gcc", "make"]
